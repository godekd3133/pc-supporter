PORT=4174
APP_HOST_PORT=4174
POSTGRES_HOST_PORT=5432
# Native bundles call this HTTPS API origin; leave empty for same-origin web development.
VITE_API_BASE_URL=
# Comma-separated browser/native origins allowed to call the API.
CORS_ALLOWED_ORIGINS=capacitor://localhost,https://localhost,http://localhost
# Required by `npm run mobile:ios:archive`; this is an identifier, not a secret.
APPLE_TEAM_ID=
PC_SUPPORTER_DATA_DIR=
# Source-price refresh scheduler (enabled by default in production; set false to disable).
PRICE_REFRESH_SCHEDULER_ENABLED=true
PRICE_REFRESH_INTERVAL_HOURS=3
PRICE_REFRESH_CORE_LIMIT=100
PRICE_REFRESH_ACCESSORY_LIMIT=500
PRICE_REFRESH_DELAY_MS=1200
# Legacy broad catalog crawl is opt-in and is skipped while price refresh is enabled.
DANAWA_CRAWL_SCHEDULER_ENABLED=false
DANAWA_CRAWL_ON_START=false
DANAWA_CRAWL_INTERVAL_HOURS=24
DANAWA_CRAWL_PAGES=1
DANAWA_CRAWL_LIMIT=5
DANAWA_CRAWL_ALL=false
DANAWA_CRAWL_DETAILS=true
DANAWA_CRAWL_DELAY_MS=850
DANAWA_CRAWL_TIMEOUT_MS=20000
DANAWA_CRAWL_RETRIES=2
DATABASE_URL=postgresql://pcsupporter:pcsupporter@127.0.0.1:5432/pcsupporter
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
