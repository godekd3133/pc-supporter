PORT=4174
APP_HOST_PORT=4174
POSTGRES_HOST_PORT=5432
# Native bundles call this HTTPS API origin; leave empty for same-origin web development.
VITE_API_BASE_URL=
# Comma-separated browser/native origins allowed to call the API.
CORS_ALLOWED_ORIGINS=capacitor://localhost,https://localhost,http://localhost
# Required by `npm run mobile:ios:archive`; this is an identifier, not a secret.
APPLE_TEAM_ID=
PC_SUPPORTER_DATA_DIR=
# Process topology: combined (local/default), api, or worker. Split API/worker requires PostgreSQL.
PC_SUPPORTER_PROCESS_ROLE=combined
# Source-price refresh scheduler (opt in for Compose/local runs after catalog and source policy are ready).
PRICE_REFRESH_SCHEDULER_ENABLED=false
PRICE_REFRESH_INTERVAL_HOURS=3
PRICE_REFRESH_CORE_LIMIT=100
PRICE_REFRESH_ACCESSORY_LIMIT=500
PRICE_REFRESH_DELAY_MS=1200
# Legacy broad catalog crawl is opt-in and is skipped while price refresh is enabled.
DANAWA_CRAWL_SCHEDULER_ENABLED=false
DANAWA_CRAWL_ON_START=false
DANAWA_CRAWL_INTERVAL_HOURS=24
DANAWA_CRAWL_PAGES=1
DANAWA_CRAWL_LIMIT=5
DANAWA_CRAWL_ALL=false
DANAWA_CRAWL_DETAILS=true
DANAWA_CRAWL_DELAY_MS=850
DANAWA_CRAWL_TIMEOUT_MS=20000
DANAWA_CRAWL_RETRIES=2
# Compose's schema-owner password is only supplied to PostgreSQL, the migration runner, and role bootstrap.
POSTGRES_OWNER_PASSWORD=
# Runtime role is separate from the database/schema owner and receives only app-table DML.
POSTGRES_RUNTIME_ROLE=pcsupporter_runtime
POSTGRES_RUNTIME_PASSWORD=
# Direct deployments set a runtime-only URL. Keep its password in PGPASSWORD when possible.
DATABASE_URL=
# Set true in the Lightsail env only after migrating and verifying existing file-backed user state.
PC_SUPPORTER_POSTGRES_DATA_MIGRATION_CONFIRMED=false
# PostgreSQL rate limits are shared across API replicas; set a stable 32+ character secret in production.
RATE_LIMIT_HMAC_SECRET=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
