{
  "name": "pc-supporter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite --host 0.0.0.0 --port 5173",
    "dev:api": "tsx watch server/index.ts",
    "preview": "vite preview --host 0.0.0.0",
    "preview:full": "node scripts/preview-full.mjs",
    "build": "tsc --noEmit && vite build && node scripts/verify-client-bundle.mjs",
    "build:mobile": "node scripts/build-mobile.mjs",
    "mobile:ios": "npm run build:mobile && cap open ios",
    "mobile:ios:archive": "node scripts/build-ios-archive.mjs",
    "mobile:android": "npm run build:mobile && cap open android",
    "mobile:android:debug": "node scripts/build-android-debug.mjs",
    "mobile:android:aab": "node scripts/build-android-aab.mjs",
    "start": "tsx server/index.ts",
    "crawl": "tsx server/crawler.ts",
    "crawl:all": "tsx server/crawler.ts --all",
    "crawl:accessories": "tsx server/accessory-crawler.ts",
    "crawl:dry": "tsx server/crawler.ts --dry-run --limit 8",
    "import:private-catalog": "tsx scripts/import-private-catalog.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1 --minWorkers=1 --pool=threads --poolOptions.threads.singleThread=true",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:browser:gaming-performance-result": "node scripts/gaming-performance-result-smoke.mjs",
    "test:browser:generator-selection-reasons": "node scripts/generator-selection-reasons-smoke.mjs",
    "test:browser:budget-ladder-summary": "node scripts/budget-ladder-summary-smoke.mjs",
    "test:browser:quote-onboarding": "node scripts/quote-onboarding-smoke.mjs",
    "test:browser:quote-onboarding-final": "node scripts/verify-onboarding-final.mjs",
    "capture:quote-onboarding": "node scripts/quote-onboarding-capture.mjs",
    "test:browser:readability": "node scripts/readability-smoke.mjs",
    "test:browser:history-priority": "node scripts/history-priority-race-probe.mjs",
    "test:browser:generator-apply-route": "node scripts/generator-apply-route-race-probe.mjs",
    "test:browser:budget-ladder-apply-route": "node scripts/budget-ladder-apply-route-race-probe.mjs",
    "test:browser:home-budget-revoke-context": "node scripts/home-budget-revoke-context-probe.mjs",
    "test:browser:home-version-revoke-context": "node scripts/home-version-revoke-context-probe.mjs",
    "test:browser:home-version-copy-route": "node scripts/home-version-copy-route-probe.mjs",
    "test:browser:build-change-apply-route": "node scripts/build-change-apply-route-probe.mjs",
    "test:browser:restore-history-route": "node scripts/restore-history-route-probe.mjs",
    "test:browser:accessory-add-route": "node scripts/accessory-add-route-probe.mjs",
    "test:browser:saved-build-save-route": "node scripts/saved-build-save-route-probe.mjs",
    "test:browser:price-watchlist-save-route": "node scripts/price-watchlist-save-route-probe.mjs",
    "test:browser:price-watchlist-link-context": "node scripts/price-watchlist-link-context-smoke.mjs",
    "test:browser:shared-version-copy-route": "node scripts/shared-version-copy-route-probe.mjs",
    "test:browser:shared-version-recheck-route": "node scripts/shared-version-recheck-route-probe.mjs",
    "test:browser:catalog-copy-route": "node scripts/catalog-copy-route-probe.mjs",
    "test:browser:shared-alternative-copy-route": "node scripts/shared-alternative-copy-route-probe.mjs",
    "test:browser:shared-watchlist-route-abort": "node scripts/shared-watchlist-route-abort-probe.mjs",
    "test:browser:shared-comparison-route-abort": "node scripts/shared-comparison-route-abort-probe.mjs",
    "test:browser:shared-comparison-live-check-abort": "node scripts/shared-comparison-live-check-abort-probe.mjs",
    "test:browser:shared-watchlist-live-price-abort": "node scripts/shared-watchlist-live-price-abort-probe.mjs",
    "test:browser:shared-budget-ladder-version-comparison-abort": "node scripts/shared-budget-ladder-version-comparison-abort-probe.mjs",
    "test:browser:shared-budget-ladder-refresh-route-abort": "node scripts/shared-budget-ladder-refresh-route-abort-probe.mjs",
    "test:browser:shared-budget-ladder-version-apply-route-abort": "node scripts/shared-budget-ladder-version-apply-route-abort-probe.mjs",
    "test:browser:shared-budget-ladder-save-route-abort": "node scripts/shared-budget-ladder-save-route-abort-probe.mjs",
    "test:browser:shared-budget-ladder-revoke-route-abort": "node scripts/shared-budget-ladder-revoke-route-abort-probe.mjs",
    "test:browser:shared-budget-ladder-partial-preview-route-abort": "node scripts/shared-budget-ladder-partial-preview-route-abort-probe.mjs",
    "test:browser:build-selection-hydration-route-abort": "node scripts/build-selection-hydration-route-abort-probe.mjs",
    "test:browser:check-hydration-route-abort": "node scripts/check-hydration-route-abort-probe.mjs",
    "test:browser:saved-build-open-hydration-route-abort": "node scripts/saved-build-open-hydration-route-abort-probe.mjs",
    "test:browser:shared-budget-ladder-route-abort": "node scripts/shared-budget-ladder-route-abort-probe.mjs",
    "test:browser:notification-route": "node scripts/browser-notification-route-probe.mjs",
    "test:browser:build-change-context": "node scripts/build-change-context-probe.mjs",
    "test:browser:saved-version-share-route": "node scripts/saved-version-share-route-probe.mjs",
    "test:browser:alternative-share-route": "node scripts/alternative-share-route-probe.mjs",
    "test:browser:persistence": "node scripts/browser-persistence-smoke.mjs",
    "test:browser:history-settings": "node scripts/history-settings-storage-smoke.mjs",
    "test:browser:price-watch-settings": "node scripts/price-watchlist-settings-storage-smoke.mjs",
    "test:browser:price-watch-baseline": "node scripts/price-watchlist-baseline-storage-smoke.mjs",
    "test:browser:notification-ledger": "node scripts/browser-notification-delivery-storage-smoke.mjs",
    "test:browser:picker-cache-storage": "node scripts/picker-cache-storage-smoke.mjs",
    "test:browser:purchase-list-context": "node scripts/purchase-list-context-smoke.mjs",
    "test:browser:clipboard-route-ownership": "node scripts/clipboard-route-ownership-smoke.mjs",
    "test:seed": "node scripts/seed-only-smoke.mjs",
    "test:postgres:comparison": "node scripts/postgres-comparison-smoke.mjs",
    "test:postgres:saved-build": "node scripts/postgres-saved-build-smoke.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "cheerio": "^1.1.2",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
